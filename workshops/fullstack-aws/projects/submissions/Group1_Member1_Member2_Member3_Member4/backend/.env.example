# Copy to backend/.env (never commit .env).

# mongomock:// = in-memory fake MongoDB, no Atlas needed (data resets on restart).
# For Atlas use: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongomock://
MONGODB_DB=noticeboard

# Long random string. PowerShell: [Convert]::ToBase64String((1..48 | % {Get-Random -Max 256}))
JWT_SECRET=change-me-to-a-long-random-string
JWT_MINUTES=120

# First HR login (created on startup if there is no HR user yet)
BOOTSTRAP_HR_EMAIL=hr@noticeboard.dev
BOOTSTRAP_HR_PASSWORD=hrAdmin123

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SILENT_DAYS=7

# true = add demo managers, cohorts, trainees and reports when the database is empty
SEED_DEMO=true
